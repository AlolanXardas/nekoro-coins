{
  "schemaVersion": 1,
  "id": "nekorocoins",
  "version": "${version}",
  "name": "Nekoro Coins",
  "description": "Adds 120 coins for use as currency, quest icons or shop items in other mods. Their names, recipes and which of them are enabled are set in the config.",
  "authors": ["Alolan Xardas"],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/nekoro-c"
  },
  "license": "MIT",
  "icon": "assets/nekorocoins/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.xardas.nekorocoins.NekoroCoins"],
    "client": ["dev.xardas.nekorocoins.NekoroCoinsClient"]
  },
  "mixins": ["nekorocoins.mixins.json"],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  }
}
